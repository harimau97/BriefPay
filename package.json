{
  "name": "briefpay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-bryntum.mjs",
    "prebuild": "node scripts/copy-bryntum.mjs",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1 --port 3010",
    "pm2:start": "pm2 startOrReload ecosystem.config.cjs",
    "pm2:stop": "pm2 stop briefpay",
    "pm2:restart": "pm2 restart briefpay --update-env",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:setup": "prisma migrate dev && prisma db seed",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.102",
    "@ai-sdk/openai": "^4.0.114",
    "@bryntum/scheduler": "npm:@bryntum/scheduler-trial@^7.3.8",
    "@bryntum/scheduler-react": "^7.3.8",
    "@onkernel/sdk": "^0.146.0",
    "@paypal/agent-toolkit": "^1.11.0",
    "@prisma/client": "^6.19.3",
    "ai": "^7.0.169",
    "cheerio": "^1.2.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
